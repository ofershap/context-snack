{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": ".cursor/hooks/context-snack-agent-state.mjs",
        "timeout": 5
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/context-snack-agent-state.mjs",
        "timeout": 5
      }
    ],
    "sessionEnd": [
      {
        "command": ".cursor/hooks/context-snack-agent-state.mjs",
        "timeout": 5
      }
    ]
  }
}
